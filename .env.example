# Self-hosting server settings (FastAPI + ReportLab backend / Docker)
PORT=8080
DATA_DIR=/app/data

# GEMINI_API_KEY: Optional runtime key if AI features are configured in AI Studio.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Optional public base URL injected by the hosting platform.
APP_URL="MY_APP_URL"
